---
const modes = [
  { title: 'Draft Only', description: 'Agent writes the reply, you hit send. Zero risk.', active: true },
  { title: 'Guided', description: 'Agent asks for approval on specific actions.' },
  { title: 'Autopilot', description: 'Let kgentik handle the entire booking process.' },
];

const permissions = [
  { label: 'Respond to Lead Messages', enabled: true },
  { label: 'Draft Follow-up SMS', enabled: true },
  { label: 'Auto-confirm Bookings', enabled: false },
];
---

<section class="section-y bg-surface">
  <div class="site-container text-center">
    <div class="relative grid grid-cols-1 items-center gap-12 overflow-hidden rounded-3xl bg-surface-container p-6 sm:p-12 lg:grid-cols-2 lg:gap-16 lg:p-20">
      <div class="relative z-10 text-left">
        <h2 class="mb-6 max-w-lg font-display text-display text-primary">You stay in control. Agents do the heavy lifting.</h2>
        <p class="mb-10 max-w-md text-body-lg text-on-surface-variant">
          kgentik isn't about replacing you. It's about empowering you. Choose the mode that fits your comfort level.
        </p>
        <div class="max-w-sm space-y-4">
          {
            modes.map((mode) => (
              <article class:list={['flex items-start gap-4 rounded-2xl border p-6 transition-all', mode.active ? 'border-outline-variant bg-white shadow-sm' : 'border-outline-variant/30 bg-white/40']}>
                <div class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full border-2 border-outline-variant">
                  {mode.active && <div class="h-2.5 w-2.5 rounded-full bg-outline-variant opacity-20"></div>}
                </div>
                <div>
                  <h3 class:list={['font-bold', mode.active ? 'text-primary' : 'text-on-surface-variant']}>{mode.title}</h3>
                  <p class:list={['text-xs text-on-surface-variant', !mode.active && 'opacity-60']}>{mode.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="relative">
        <div class="relative z-10 mx-auto max-w-md rounded-3xl border border-outline-variant bg-white p-6 shadow-2xl sm:p-8">
          <div class="mb-8 flex items-center justify-between border-b border-surface-container pb-4">
            <h3 class="font-bold text-primary">Agent Permissions</h3>
            <span class="rounded-full bg-secondary-container/20 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-on-secondary-container">Editing</span>
          </div>
          <div class="space-y-8">
            {
              permissions.map((permission) => (
                <div class:list={['flex items-center justify-between gap-5', !permission.enabled && 'opacity-60']}>
                  <span class="text-left text-sm font-medium text-on-surface-variant">{permission.label}</span>
                  <span class:list={['relative h-5 w-10 rounded-full', permission.enabled ? 'bg-secondary-container' : 'bg-surface-container-highest']}>
                    <span class:list={['absolute top-1 h-3 w-3 rounded-full', permission.enabled ? 'right-1 bg-primary' : 'left-1 bg-white']}></span>
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="absolute -right-10 -top-10 -z-0 h-40 w-40 rounded-full bg-secondary-container/20 blur-3xl"></div>
      </div>
    </div>
  </div>
</section>
