<section class="section-y bg-surface" id="industries">
  <div class="site-container">
    <div class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <span class="eyebrow mb-4 block text-secondary">Tailored Intelligence</span>
        <h2 class="font-display text-h1 text-primary sm:text-[40px]">
          Specialized for the trades that build and fix our world.
        </h2>
      </div>
      <div class="hidden gap-2 sm:flex" aria-hidden="true">
        <span class="rounded-full border border-outline-variant p-3"><span class="material-symbols-outlined">chevron_left</span></span>
        <span class="rounded-full border border-outline-variant bg-primary-container p-3 text-white"><span class="material-symbols-outlined">chevron_right</span></span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        industries.map((industry) => (
          <article class="group overflow-hidden rounded-2xl border border-outline-variant bg-white transition-all hover:shadow-lg">
            <div class="h-48 overflow-hidden">
              <img alt={industry.alt} class="h-full w-full object-cover transition-transform group-hover:scale-105" src={industry.image} />
            </div>
            <div class="p-6">
              <h3 class="mb-2 text-h2 text-primary">{industry.name}</h3>
              <p class="text-on-surface-variant">{industry.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
