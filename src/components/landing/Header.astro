---
const navItems = [
  { label: 'Industries', href: '/#industries' },
  { label: 'Features', href: '/#features' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-primary-container/85 shadow-sm backdrop-blur-xl">
  <div class="site-container flex items-center justify-between py-4">
    <a class="inline-flex items-center" href="/" aria-label="Kgentik home">
      <img class="h-8 w-auto object-contain" src="/brand/kgentik-logo-light.png" alt="Kgentik" width="160" height="44" />
    </a>
    <nav class="hidden items-center space-x-8 md:flex" aria-label="Main navigation">
      {navItems.map((item) => <a class="font-medium text-white/80 transition-all hover:text-white" href={item.href}>{item.label}</a>)}
    </nav>
    <a
      class="rounded-full bg-secondary-container px-5 py-2.5 text-sm font-bold text-on-secondary-container duration-200 active:scale-95 sm:px-6"
      href="/#pricing"
    >
      Book Demo
    </a>
  </div>
</header>
