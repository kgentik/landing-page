---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import Footer from '../../components/landing/Footer.astro';
import Header from '../../components/landing/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | kgentik`} description={post.data.description}>
  <Header />
  <main class="bg-surface">
    <article class="section-y">
      <div class="site-container max-w-3xl">
        <a class="mb-8 inline-flex items-center gap-2 text-sm font-bold text-secondary" href="/blog">
          <span class="material-symbols-outlined text-base">arrow_back</span>
          Back to blog
        </a>
        <header class="mb-10">
          <p class="eyebrow mb-4 text-secondary">
            {post.data.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
          <h1 class="mb-6 font-display text-display text-primary">{post.data.title}</h1>
          <p class="text-body-lg text-on-surface-variant">{post.data.description}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => <span class="rounded-full bg-secondary-container/20 px-3 py-1 text-xs font-bold text-secondary">{tag}</span>)}
          </div>
        </header>
        <div class="rounded-3xl border border-outline-variant bg-white p-6 shadow-sm sm:p-10">
          <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-primary prose-a:text-secondary prose-strong:text-primary">
            <Content />
          </div>
        </div>
        <aside class="mt-10 rounded-3xl bg-primary-container p-6 text-white sm:p-8">
          <h2 class="mb-3 text-h2">Want every local enquiry to get a next step?</h2>
          <p class="mb-6 text-on-primary-container">
            kgentik helps local businesses automate lead capture, quote follow-up, reviews, and marketing operations.
          </p>
          <a class="inline-flex rounded-2xl bg-secondary-container px-6 py-3 font-bold text-primary" href="/#pricing">
            Book a free demo
          </a>
        </aside>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
