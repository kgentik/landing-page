{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kgentik-landing-page",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
